echo '🤔🤔🤔🤔 ...Alright, the code looks good to me... 🤔🤔🤔🤔';

echo '👷🔨👷🔨 ...Attempting to create the production build... 👷🔨👷🔨';

# Build the backend project
bun run --filter learnify-backend build || (
    echo '❌👷🔨❌ Looks like a "backend" build failure... Better call Bob! ❌👷🔨❌';
    echo 'The build failed: Check the errors above to understand what went wrong.';
    false;
)

# Build the frontend project
bun run --filter learnify-frontend build || (
    echo '❌👷🔨❌ Looks like a "frontend" build failure... Better call Bob! ❌👷🔨❌';
    echo 'The build failed: Check the errors above to understand what went wrong.';
    false;
)

echo '🚨 Validating the branch name before pushing the code'

local_branch="$(git rev-parse --abbrev-ref HEAD)"

valid_branch_regex="^(main|development|feature|bugfix|improvement|library|prerelease|release|hotfix)(-[a-z0-9._-]+)?$"

if [[ ! $local_branch =~ $valid_branch_regex ]]
then
    echo "❌🤘🔥 Uh-oh! Your branch name seems to be off-key. In this project 🔥🤘❌"
    echo "❌🤘🔥 We groove to a specific beat: main | development | feature | bugfix | improvement | library | prerelease | release | hotfix 🔥🤘❌" 
    echo "❌🤘🔥 Your commit ain't jamming with our vibe. Time to remix that branch name and rock it again! 🔥🤘❌"
    exit 1
fi

echo '🚀🚀🚀🚀 ...All good! Pushing the code... 🚀🚀🚀🚀';

exit 0

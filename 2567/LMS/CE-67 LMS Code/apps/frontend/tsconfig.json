{
	"include": ["**/*", "**/.server/**/*", "**/.client/**/*", "../packages", ".react-router/types/**/*"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "vite/client", "@types/bun"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "../../", "./.react-router/types"],
		"baseUrl": ".",
		"paths": {
			"~/*": ["./*"],
			"@/*": ["./app/*"],
			"@shared/*": ["../packages/*"]
		},
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	},
	// "include": ["app", "../packages", ".react-router/types/**/*"],
	"exclude": ["node_modules", "dist", "build", ".react-router"]
}

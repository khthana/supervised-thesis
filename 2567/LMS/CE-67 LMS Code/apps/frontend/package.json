		"@types/node": "^20",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"@types/validator": "^13.12.2",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.5.2",
		"react-error-overlay": "^6.0.11",
		"react-router-devtools": "^1.1.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.2",

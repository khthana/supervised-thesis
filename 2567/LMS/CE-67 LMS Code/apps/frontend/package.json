{
	"name": "learnify-frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"envx": "bunx dotenvx run -f env/.env.development --",
		"build": "bun run envx -- react-router build",
		"dev": "bun run envx -- react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && biome check . && tsc --noEmit",
		"format": "biome format .",
		"format:fix": "biome format --write . && biome check --write .",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",

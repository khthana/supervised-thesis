{
	"extends": ["../../biome.json"],
	"files": {
		"ignoreUnknown": false,
		"ignore": ["node_modules/**/*", "dist/**/*", "build/**/*", "coverage/**/*", "@types/**"]
	},
	"organizeImports": {
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error",
				"noConfusingVoidType": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"useExhaustiveDependencies": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useTemplate": "error",
				"noUselessElse": "error",
				"noImplicitBoolean": "error",
				"noVar": "error"
			},
			"complexity": {
				"recommended": true,
				"noForEach": "error",
				"noEmptyTypeParameters": "error",
				"noUselessCatch": "error",
				"noUselessEmptyExport": "error",
				"noBannedTypes": "error",
				"noUselessConstructor": "error",
				"noUselessRename": "error",
				"noUselessSwitchCase": "error",
				"useRegexLiterals": "error"
			},
			"performance": {
				"noBarrelFile": "off",
				"noDelete": "error",
				"noAccumulatingSpread": "error"
			}
		}
	}
}

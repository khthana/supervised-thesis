# Environment Configuration
NODE_ENV="development" # Options: "development", "production"
PORT="5000"            # The port your server will listen on
HOST="localhost"       # Hostname for the server
FRONTEND_URL="http://localhost:3000" # URL for the frontend

# CORS Settings
#CORS_ORIGIN="http://localhost:*" # Allowed CORS origin, adjust as necessary
CORS_ORIGIN="*"

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000" # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="200" # Max number of requests per window per IP

# Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="learnifydb"
DB_BACKEND_USER="potgres"
DB_BACKEND_PASSWORD="sosecret"
DB_URL="postgresql://${DB_BACKEND_USER}:${DB_BACKEND_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Video Server Configuration
VIDEO_SECRET_KEY="sosecret"
VIDEO_SERVER_URL="http://localhost:8888"

# Streaming Configuration
VIDEO_SERVER_URL="http://localhost:8888"
VIDEO_SECRET_KEY="http://localhost:8888"
MEDIA_SERVER_URL="http://localhost:8888"

# Access Token Configuration
ACCESS_TOKEN_SECRET="k4.secret.????"
ACCESS_TOKEN_PUBLIC="k4.public.????"
ACCESS_TOKEN_EXP="30m"

# Refresh Token Configuration
REFRESH_TOKEN_SECRET="k4.secret.????"
REFRESH_TOKEN_PUBLIC="k4.public.????"
REFRESH_TOKEN_EXP="3d"

# Verify Token Configuration
VERIFY_TOKEN_SECRET="k4.secret.????"
VERIFY_TOKEN_PUBLIC="k4.public.????"

# OAuth2 Google Configuration
NOREPLY_EMAIL="noreply@mail.com"
NOREPLY_EMAIL_PASSWORD=""
OAUTH2_GOOGLE_CLIENT_ID="?????????????.apps.googleusercontent.com"
OAUTH2_GOOGLE_CLIENT_SECRET=""
OAUTH2_GOOGLE_AUTH_URL="https://accounts.google.com/o/oauth2/auth"
OAUTH2_GOOGLE_TOKEN_URL="https://oauth2.googleapis.com/token"
OAUTH2_GOOGLE_TOKENINFO_URL="https://www.googleapis.com/oauth2/v2/userinfo?alt=json"

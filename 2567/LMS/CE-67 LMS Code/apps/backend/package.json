{
	"name": "learnify-backend",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"format": "biome format .",
		"format:fix": "biome format --write . && biome check --write .",
		"lint": "biome lint .",
		"typecheck": "biome check . && tsc --noEmit",
		"envx": "bunx dotenvx run -f env/.env.development --",
		"dev": "bun run envx -- bun --hot run src/index.ts",
		"clean": "rimraf build coverage",
		"test": "bun run envx -- vitest run",
		"build": "tsup --out-dir build",
		"start": "bun run envx -- bun run build/index.js",
		"prisma:generate": "bun run envx -- bunx prisma generate",
		"prisma:migrate": "bun run envx -- bunx prisma migrate dev",
		"prisma:push": "bun run envx -- bunx prisma db push",
		"prisma:pull": "bun run envx -- bunx prisma db pull",
		"prisma:studio": "bun run envx -- bunx prisma studio"
	},
	"tsup": {
		"entry": ["src", "!src/**/__tests__/**", "!src/**/*.test.*"],
		"splitting": false,
		"sourcemap": true,
		"clean": true,
		"format": ["esm"],
		"loader": {
			".html": "text",
			".ejs": "text"
		}
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "7.2.0",
		"@bull-board/express": "^6.7.10",
		"@dotenvx/dotenvx": "latest",
		"@prisma/client": "^6.5.0",
		"@types/cookie-parser": "^1.4.8",
		"@types/ioredis": "^5.0.0",
		"@types/redis": "^4.0.11",
		"bullmq": "^5.44.3",
		"cookie-parser": "^1.4.7",
		"cors": "2.8.5",
		"ejs": "3.1.10",
		"envalid": "8.0.0",
		"express": "^5.0.1",
		"express-rate-limit": "7.5.0",
		"formidable": "^3.5.2",
		"helmet": "8.0.0",
		"http-status-codes": "2.3.0",
		"ioredis": "^5.6.0",
		"paseto-ts": "1.5.7",
		"pg": "8.13.1",
		"pino": "9.5.0",
		"pino-http": "10.3.0",
		"redis": "^4.7.0",
		"swagger-ui-express": "5.0.1",
		"zod": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/cors": "2.8.17",
		"@types/ejs": "3.1.5",
		"@types/formidable": "^3.4.5",
		"@types/multer": "^1.4.12",
		"@types/nodemailer": "6.4.16",
		"@types/supertest": "6.0.2",
		"@types/swagger-ui-express": "4.1.7",
		"pino-pretty": "^13.0.0",
		"prisma": "^6.5.0",
		"rimraf": "6.0.1",
		"supertest": "7.0.0",
		"tsup": "8.3.5",
		"typescript": "^5.8.2",
		"vite-tsconfig-paths": "5.1.2",
		"vitest": "3.0.4"
	}
}
